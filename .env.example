# Copy this file to .env and adjust as needed.
# Default settings run the entire mega-service with NO external
# dependencies and NO model download -- good for a first look.

# --- multi-backend LLM selection --------------------------------------
# NetGenie ships THREE selectable LLM backends behind one OpenAI-compatible
# client. Users pick between them live in the UI (top of the Console
# panel) or per-request via the "backend" field on POST /v1/chat -- no
# restart needed to switch. DEFAULT_BACKEND is only what's pre-selected.
#
#   mock  -- deterministic offline template. Zero dependencies, zero
#            network calls, always available. Good default for judges
#            with no setup step and no API key requirement.
#   local -- small model on your own Ollama container (default 3B --
#            fast enough for CPU-only demos, fully private/local,
#            requires `docker compose --profile llm up` + one `ollama pull`).
#   groq  -- Groq's hosted OpenAI-compatible API running a much larger
#            model (default 70B) for noticeably higher answer quality.
#            Needs GROQ_API_KEY below; if it's blank the UI greys this
#            option out and the gateway silently falls back to mock
#            rather than erroring if it's requested anyway.
DEFAULT_BACKEND=mock

# Kept for backward compatibility with the single-backend setup; the
# per-request "backend" selector above is the recommended way to switch
# backends now, but MOCK_LLM still controls the *worker's* solo/offline
# default when no gateway is involved.
MOCK_LLM=true

# --- local backend (Ollama) --------------------------------------------
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=not-needed

# --- groq backend --------------------------------------------------------
# Get a free key at https://console.groq.com/keys -- leave blank to keep
# the "groq" option greyed out in the UI.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- legacy single-backend variables (still used as fallback defaults) ---
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_S=30

# How long the GATEWAY waits for a WORKER's response (not the LLM call
# directly). With a real backend selected, the telemetry worker makes its
# own internal LLM call, and on a cold Ollama start the model has to load
# into memory before it generates anything -- easily 60-90s on CPU the
# first time. If you see "httpx.ReadTimeout" / "Internal Server Error"
# in the UI right after switching to a real model, raise this rather
# than LLM_TIMEOUT_S. Tip: run one throwaway chat request right after
# starting Ollama to "warm" the model before your real demo/benchmark.
WORKER_TIMEOUT_S=90

# --- ports -------------------------------------------------------------
GATEWAY_PORT=9000
GUARDRAILS_PORT=6001
RETRIEVAL_PORT=6002
TELEMETRY_PORT=6003
